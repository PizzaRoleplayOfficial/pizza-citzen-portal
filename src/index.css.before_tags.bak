:root {
  color-scheme: dark;
  --primary: #00ff88;
  --primary-glow: rgba(0, 255, 136, 0.4);
  --secondary: #00d4ff;
  --bg-dark: #0a0c10;
  --bg-grad-1: #1a2a3a;
  --bg-grad-2: #0d1520;
  --bg-card: rgba(25, 30, 40, 0.7);
  --text-main: #f0f2f5;
  --text-muted: #94a3b8;
  --border: rgba(255, 255, 255, 0.1);
  --glass-bg: rgba(15, 20, 30, 0.8);
  --glass-border: rgba(255, 255, 255, 0.08);
  --nav-bg: #12161f;
  --panel-bg: rgba(20,25,35,0.6);
  --input-bg: rgba(0,0,0,0.2);
  --input-text: #fff;
  --error: #ff4757;
  --success: #2ed573;
  --btn-secondary-bg: rgba(255, 255, 255, 0.05);
  --btn-secondary-hover: rgba(255, 255, 255, 0.1);
  --btn-secondary-text: #fff;
  --modal-overlay: rgba(10,12,16,0.85);
  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
}

:root[data-theme='light'] {
  color-scheme: light;
  --primary: #00c166;
  --primary-glow: rgba(0, 193, 102, 0.3);
  --secondary: #00a0cc;
  --bg-dark: #f0f4f8;
  --bg-grad-1: #ffffff;
  --bg-grad-2: #e0e7ee;
  --bg-card: #ffffff;
  --text-main: #2b3a4a;
  --text-muted: #64748b;
  --border: rgba(0, 0, 0, 0.1);
  --glass-bg: rgba(255, 255, 255, 0.95);
  --glass-border: rgba(0, 0, 0, 0.08);
  --nav-bg: #ffffff;
  --panel-bg: #ffffff;
  --input-bg: #ffffff;
  --input-text: #2b3a4a;
  --btn-secondary-bg: #ffffff;
  --btn-secondary-hover: #f1f5f9;
  --btn-secondary-text: #2b3a4a;
  --modal-overlay: rgba(100,116,139,0.5);
}


* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background-color: var(--bg-dark);
  background-image: 
    radial-gradient(circle at 50% -20%, var(--bg-grad-1), transparent),
    radial-gradient(circle at 0% 100%, var(--bg-grad-2), transparent);
  color: var(--text-main);
  font-family: var(--font-sans);
  min-height: 100vh;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* Glassmorphism Utility */
.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes glow {
  0% { box-shadow: 0 0 5px var(--primary-glow); }
  50% { box-shadow: 0 0 20px var(--primary-glow); }
  100% { box-shadow: 0 0 5px var(--primary-glow); }
}

.animate-fade {
  animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* Typography */
h1 {
  font-size: 2.5rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(to right, var(--text-main), var(--primary));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  border-radius: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  border: none;
  font-size: 0.95rem;
}

.btn svg {
  color: inherit;
  stroke: currentColor;
}

.btn-primary {
  background: var(--primary);
  color: #000;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px var(--primary-glow);
}

.btn-secondary {
  background: var(--btn-secondary-bg);
  color: var(--btn-secondary-text);
  border: 1px solid var(--glass-border);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
}

/* Cards */
.card {
  padding: 24px;
  transition: transform 0.3s ease, border-color 0.3s ease;
}

.card:hover {
  transform: translateY(-4px);
  border-color: var(--primary);
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px; /* Added for horizontal scrollbar */
}

::-webkit-scrollbar-track {
  background: var(--bg-dark);
}

::-webkit-scrollbar-thumb {
  background: var(--glass-border);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}

.image-gallery::-webkit-scrollbar {
  display: none;
}
.image-gallery {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Layout Utilities */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 32px;
}

@media (min-width: 769px) {
  .list-view {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .list-view .card {
    flex-direction: row !important;
    align-items: stretch;
  }
  .list-view .card > div:first-child {
    width: 250px !important;
    height: auto !important;
    min-height: 200px;
    flex-shrink: 0;
  }
  .list-view .card > div:nth-child(2) {
    display: flex !important;
    gap: 32px;
    align-items: center;
    padding: 24px !important;
    flex-direction: row !important;
  }
  
  .list-view .card > div:nth-child(2) > div:first-child {
    flex: 2; /* Title / Status area */
  }
  .list-view .card > div:nth-child(2) > div:nth-child(3) {
    flex: 1; /* Trim / Color area */
    margin-bottom: 0 !important;
  }
  .list-view .card > div:nth-child(2) > div:nth-child(4) {
    flex: 1; /* License plate area */
    margin-bottom: 0 !important;
  }
  .list-view .card > div:nth-child(2) > div:last-child {
    flex-shrink: 0; /* Action buttons area */
    flex-direction: column;
  }
}

@media (max-width: 768px) {
  .list-view {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
}


.main-nav {
  background: var(--nav-bg);
  padding: 16px 32px;
  border-bottom: 1px solid var(--glass-border);
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 32px;
  align-items: center;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  color: var(--primary);
  font-size: 1.4rem;
  font-weight: 800;
  white-space: nowrap;
}

.nav-tabs {
  display: flex;
  gap: 12px;
  align-items: center;
}

.nav-btn {
  background: var(--btn-secondary-bg);
  color: var(--btn-secondary-text);
  border: 1px solid var(--glass-border);
  padding: 10px 20px;
  border-radius: 30px;
  font-weight: 600;
  font-size: 0.9rem;
  white-space: nowrap;
}

.nav-btn.active {
  background: var(--primary);
  color: #000;
  border: 1px solid var(--primary);
}

.nav-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  background: var(--error);
  color: #fff;
  font-size: 0.65rem;
  font-weight: 800;
  padding: 2px 6px;
  border-radius: 12px;
  line-height: 1;
  min-width: 18px;
  text-align: center;
}

.admin-nav-btn {
  background: var(--btn-secondary-bg);
  color: var(--btn-secondary-text);
  border: 1px solid var(--glass-border);
  padding: 12px 18px;
  border-radius: 30px;
  font-weight: 600;
  font-size: 0.95rem;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  justify-content: flex-start;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  position: relative;
}

.admin-nav-btn.active {
  background: var(--primary);
  color: #000;
  border: 1px solid var(--primary);
  box-shadow: 0 4px 12px rgba(0, 193, 102, 0.3);
}

.admin-nav-btn .nav-badge {
  position: static;
  margin-left: auto;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.nav-user-info {
  text-align: right;
}

.view-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40px;
}

.admin-tabs-container {
  display: flex;
  background: var(--btn-secondary-bg);
  padding: 6px;
  border-radius: 16px;
  gap: 6px;
  border: 1px solid var(--glass-border);
  overflow-x: auto;
  flex-wrap: nowrap;
  white-space: nowrap;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .container {
    padding: 0 16px;
  }
  
  .main-nav {
    grid-template-columns: auto auto;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
  }
  
  .nav-tabs-wrapper {
    grid-column: 1 / -1;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0;
    margin: 0 -16px;
    padding-left: 16px;
    padding-right: 16px;
  }
  .nav-tabs-wrapper::-webkit-scrollbar {
    display: none;
  }
  
  .nav-user-info {
    display: none; /* hide on small screens to save space */
  }

  .card-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .view-header {
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .admin-tabs-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .admin-tabs-container::-webkit-scrollbar {
    display: none;
  }

  h1 { font-size: 1.8rem !important; }
  h2 { font-size: 1.5rem !important; }
  h3 { font-size: 1.3rem !important; }

  .mobile-only-card {
    background: var(--panel-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .modal-content {
    width: 95% !important;
    padding: 24px !important;
    max-height: 90vh;
    overflow-y: auto;
  }

  .btn {
    padding: 10px 16px;
    font-size: 0.85rem;
  }

  .hide-on-mobile {
    display: none !important;
  }
  
  .responsive-flex-col {
    flex-direction: column !important;
    align-items: stretch !important;
  }
}

@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.animate-spin { animation: spin 1s linear infinite; }

/* Admin Sidebar Layout */
.admin-layout-wrapper {
  background: var(--bg-dark);
  min-height: 100vh;
  display: flex;
}

.admin-sidebar {
  width: 250px;
  background: var(--panel-bg);
  border-right: 1px solid var(--glass-border);
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  height: 100vh;
  position: sticky;
  top: 0;
  /* transition moved to mobile query */
  z-index: 1050;
}

.admin-sidebar-header {
  font-size: 1.2rem;
  font-weight: 800;
  margin-bottom: 32px;
  padding: 0 12px;
  color: var(--primary);
  display: flex;
  align-items: center;
  gap: 8px;
}

.admin-sidebar-menu {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.user-link {
  color: var(--primary);
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s ease;
}
.user-link:hover {
  text-shadow: 0 0 8px rgba(0, 193, 102, 0.4);
  opacity: 0.8;
}

.admin-sidebar-item {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--btn-secondary-bg);
  color: var(--btn-secondary-text);
  border: 1px solid var(--glass-border);
  padding: 12px 20px;
  border-radius: 30px;
  font-weight: 600;
  font-size: 0.95rem;
  transition: all 0.2s ease;
  cursor: pointer;
  white-space: nowrap;
}

.admin-sidebar-item:hover {
  background: var(--btn-secondary-hover);
  color: var(--text-main);
}

.admin-sidebar-item.active {
  background: var(--primary);
  color: #000;
  border: 1px solid var(--primary);
}

.admin-sidebar-item.active svg {
  color: #000;
}

.admin-main-area {
  flex: 1;
  padding: 40px;
  height: 100vh;
  overflow-y: auto;
}

.admin-mobile-header {
  display: none;
  padding: 16px;
  background: var(--nav-bg);
  border-bottom: 1px solid var(--glass-border);
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 998;
}

/* Sidebar backdrop overlay - blocks interaction with content behind sidebar on mobile */
.admin-sidebar-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 1040;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  animation: fadeIn 0.2s ease;
}
.admin-sidebar-backdrop.open {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 768px) {
  .admin-sidebar {
    position: fixed;
    left: 0;
    /* Fully opaque - no see-through on mobile */
    background: var(--bg-dark, #0d0d0d) !important;
    border-right: 1px solid rgba(255,255,255,0.1);
    transform: translateX(-100%);
    box-shadow: none;
    z-index: 1050;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .admin-sidebar.open {
    transform: translateX(0);
    box-shadow: 10px 0 40px rgba(0,0,0,0.5);
  }
  .admin-main-area {
    padding: 20px 16px;
  }
  .admin-mobile-header {
    display: flex;
    margin: -20px -16px 24px -16px;
    padding: 16px 20px;
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    top: 0;
  }
}

/* Skeleton Loading Screens */
@keyframes skeleton-shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.skeleton {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.03) 25%,
    rgba(255, 255, 255, 0.09) 37%,
    rgba(255, 255, 255, 0.03) 63%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease infinite;
}

:root[data-theme='light'] .skeleton {
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.04) 25%,
    rgba(0, 0, 0, 0.09) 37%,
    rgba(0, 0, 0, 0.04) 63%
  );
  background-size: 200% 100%;
}

.skeleton-text {
  height: 16px;
  border-radius: 6px;
}
.skeleton-text.short {
  width: 50%;
}
.skeleton-text.medium {
  width: 75%;
}
.skeleton-title {
  height: 28px;
  border-radius: 8px;
  width: 40%;
}
.skeleton-circle {
  border-radius: 50%;
}
.skeleton-rect {
  border-radius: 12px;
}

/* OCR Progress Loader Bar */
.ocr-progress-container {
  width: 100%;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  height: 8px;
  overflow: hidden;
  position: relative;
  border: 1px solid var(--glass-border);
}
.ocr-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  transition: width 0.3s ease;
  box-shadow: 0 0 8px var(--primary-glow);
}

.animate-spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}


