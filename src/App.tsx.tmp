const carModels = carModelsRaw as Record<string, string[]>;

type VehicleStatus = 'approved' | 'pending' | 'rejected';

interface Vehicle {
  id: string;
  owner_id: string;
  maker: string;
  model: string;
  year: number;
  trim: string;
  color: string;
  plate: string;
  plate_region: string;
  status: VehicleStatus;
  reject_reason?: string;
  created_at?: string;
  roblox_username: string;
  discord_username?: string;
  discord_avatar?: string;
  image_data?: string;
}

interface User {
  id: string;
  username: string;
  avatar: string;
  role: 'user' | 'admin';
  roblox_username?: string;
}

