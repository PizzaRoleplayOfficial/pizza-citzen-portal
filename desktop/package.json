{
  "name": "pizza-citzen-portal-desktop",
  "version": "2.8.7",
  "description": "ぴっざぁ市民ポータル Windows デスクトップ版 (Discord風 省エネ常駐 & ネイティブ通知)",
  "main": "main.js",
  "author": "PizzaRoleplayOfficial",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "jp.pizzaroleplay.citizenportal",
    "productName": "ぴっざぁ市民ポータル",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ぴっざぁ市民ポータル"
    }
  }
}
