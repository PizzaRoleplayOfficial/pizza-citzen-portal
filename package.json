{
  "name": "gv-vehicle-registry",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "rimraf dist",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev --compatibility-date=2024-04-01 --d1 D1_DB --proxy 5173 npm run dev",
    "pages:deploy": "npm run build && wrangler pages deploy dist --branch main"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-media-session": "^8.0.24",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@cloudflare/workers-types": "^4.20240320.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.1",
    "playwright": "^1.59.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.2.2",
    "vite": "^8.0.8",
    "wrangler": "^4.95.0"
  }
}
